# ATLANTIS server config
# Copy to .env and fill in your Telegram bot credentials (from @BotFather).

# Your bot's HTTP API token (required for Telegram auth verification).
# Leave empty to run in localStorage-only mode (dev).
TELEGRAM_BOT_TOKEN=

# Your bot username WITHOUT the leading @ (used for Login Widget + display).
TELEGRAM_BOT_NAME=AtlantisCodeGame_bot

# Your public domain/host where the page is served (e.g. https://atlantis.example.com).
# Used by the Login Widget as the callback origin. Empty = current origin.
TELEGRAM_DOMAIN=

# Port the static server listens on (default 8080).
PORT=8080
